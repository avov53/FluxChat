                                                <TextBox x:Name="AutoDndStartInput" Grid.Column="2" MinHeight="34" ToolTip="Start HH:mm" LostFocus="AutoDndTimeInput_OnLostFocus"/>
                                                <TextBox x:Name="AutoDndEndInput" Grid.Column="4" MinHeight="34" ToolTip="End HH:mm" LostFocus="AutoDndTimeInput_OnLostFocus"/>
                                            </Grid>
                                            <TextBlock x:Name="AutoDndStatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
