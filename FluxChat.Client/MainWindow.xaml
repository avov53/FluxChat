                         Visibility="Collapsed"
                         TextChanged="ChatSearchInput_OnTextChanged"
                         KeyDown="ChatSearchInput_OnKeyDown"/>
                <Button x:Name="CreateGroupButton"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Background="#363940"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Create group"
                        Click="CreateGroupButton_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
