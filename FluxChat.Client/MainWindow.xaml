                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="18,18,18,14">
                                <TextBlock x:Name="SettingsPanelTitleText"
                                           Text="Settings"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBox x:Name="SettingsSearchInput"
                                         MinHeight="34"
                                         Margin="0,12,0,0"
                                         Padding="10,6"
                                         VerticalContentAlignment="Center"
                                         Background="#30333a"
                                         BorderBrush="#464956"
