                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="-"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="18"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="AvatarEditorZoomSlider"
                                    Grid.Column="2"
                                    Minimum="1"
                                    Maximum="3"
                                    Value="1"
                                    ValueChanged="AvatarEditorZoomSlider_OnValueChanged"/>
                            <TextBlock Grid.Column="4"
                                       Text="+"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="18"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="AvatarEditorVideoControls"
                              Grid.Row="6"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Start"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="AvatarEditorVideoStartSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="60"
                                    Value="0"
                                    ValueChanged="AvatarEditorVideoSlider_OnValueChanged"/>
                            <TextBlock Grid.Row="2"
                                       Text="Length"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="AvatarEditorVideoDurationSlider"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="10"
                                    Value="10"
                                    ValueChanged="AvatarEditorVideoSlider_OnValueChanged"/>
                        </Grid>

                        <DockPanel Grid.Row="8">
                            <Button Content="Reset"
                                    Style="{StaticResource StatusMenuButton}"
                                    Click="AvatarEditorResetButton_OnClick"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Cancel"
                                        Width="96"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource GhostButton}"
                                        Click="AvatarEditorCancelButton_OnClick"/>
                                <Button Content="Apply"
                                        Width="96"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="AvatarEditorApplyButton_OnClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="FirstRunVpsOverlay"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Background="#B0000000">
            <Grid>
                <Border Width="360"
                        Background="#2b2d31"
                        BorderBrush="#45474f"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="28"
                                          ShadowDepth="0"
                                          Opacity="0.45"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="VPS SERVER"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FirstRunServerAddressInput"
                                     MinHeight="38"
                                     ToolTip="host:port"/>
                            <Button Grid.Column="2"
                                    Content="Link"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="FirstRunLinkButton_OnClick"/>
                        </Grid>

                        <TextBox x:Name="FirstRunServerAccessKeyInput"
                                 Grid.Row="4"
                                 MinHeight="38"
                                 ToolTip="Invite code or saved token"/>

                        <Button Grid.Row="6"
                                Content="VPS help"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch"
                                Click="VpsHelpButton_OnClick"/>

                        <Button Grid.Row="8"
                                Content="Later"
                                Style="{StaticResource StatusMenuButton}"
                                HorizontalAlignment="Center"
                                Click="FirstRunLaterButton_OnClick"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
