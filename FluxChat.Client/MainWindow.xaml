                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock x:Name="NotificationsDesktopTitleText" Text="DESKTOP NOTIFICATIONS" Foreground="{StaticResource SubtleBrush}" FontSize="11" FontWeight="Bold"/>
                                            <CheckBox x:Name="DesktopNotificationsCheck" Content="Desktop notifications" Style="{StaticResource SmoothCheckBox}" Margin="0,14,0,0" Checked="NotificationSettingsCheck_OnChanged" Unchecked="NotificationSettingsCheck_OnChanged"/>
                                            <CheckBox x:Name="TaskbarFlashCheck" Content="Flash FluxChat on the taskbar for new messages" Style="{StaticResource SmoothCheckBox}" Margin="0,12,0,0" Checked="NotificationSettingsCheck_OnChanged" Unchecked="NotificationSettingsCheck_OnChanged"/>
                                            <CheckBox x:Name="FriendRequestNotificationsCheck" Content="Notify when someone sends a friend request" Style="{StaticResource SmoothCheckBox}" Margin="0,12,0,0" Checked="NotificationSettingsCheck_OnChanged" Unchecked="NotificationSettingsCheck_OnChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
