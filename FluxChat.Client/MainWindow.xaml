                    </Viewbox>
                </Button>

                <Button x:Name="GroupMembersButton"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Background="#363940"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Group members"
                        Visibility="Collapsed"
                        Click="GroupMembersButton_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#404249"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4a4d55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="18" Height="18">
