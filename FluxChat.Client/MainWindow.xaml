                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="7" Background="#343956">
                                                    <TextBlock Text="{Binding FileTypeText}"
                                                               Foreground="#c8ceff"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="270">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FileSizeText}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="4"
                                                        Tag="{Binding}"
                                                        Width="36"
                                                        Height="36"
                                                        Padding="0"
                                                        Style="{StaticResource GhostButton}"
                                                        ToolTip="Download or open file"
                                                        Click="MessageFileOpenButton_OnClick">
                                                    <Path Width="18" Height="18" Stretch="Uniform"
                                                          Fill="{StaticResource TextBrush}"
                                                          Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding ReactionItems}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReactions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            Click="ReactionButton_OnClick"
                                                            Padding="7,3"
                                                            Margin="0,0,6,5"
                                                            MinHeight="28"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            ToolTip="Click to remove your reaction">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#2f3138"/>
                                                                <Setter Property="BorderBrush" Value="#454852"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="ReactionBorder"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="12"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ReactionBorder" Property="Background" Value="#3a3d47"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                        <Setter Property="Background" Value="#343b63"/>
                                                                        <Setter Property="BorderBrush" Value="#5865f2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding ImageUrl}"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Stretch="Uniform"/>
                                                            <TextBlock Text="{Binding CountText}"
                                                                       Margin="5,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="edited"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="MessageHoverActions"
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="8,0,0,0"
                                            Opacity="0">
                                    <StackPanel.Resources>
                                        <Style x:Key="MessageHoverActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Width" Value="30"/>
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="#30333A"/>
                                            <Setter Property="BorderBrush" Value="#444957"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ButtonBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#383C46"/>
                                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5865F2"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4651C9"/>
                                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6D77F8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanShowMessageActions}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Style="{StaticResource MessageHoverActionButton}" ToolTip="Forward" Click="MessageForwardMenuItem_OnClick">
                                        <Viewbox Width="16" Height="16">
                                            <Path Fill="{StaticResource TextBrush}"
                                                  Data="M14,9V5L21,12L14,19V14.9C9,14.9 5.5,16.5 3,20C4,15 7,10 14,9Z"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Style="{StaticResource MessageHoverActionButton}" Margin="4,0,0,0" ToolTip="Reply" Click="MessageReplyMenuItem_OnClick">
                                        <Viewbox Width="16" Height="16">
                                            <Path Fill="{StaticResource TextBrush}"
                                                  Data="M10,9V5L3,12L10,19V14.9C15,14.9 18.5,16.5 21,20C20,15 17,10 10,9Z"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Margin="4,0,0,0" ToolTip="Edit" Click="MessageEditMenuItem_OnClick">
                                        <Viewbox Width="15" Height="15">
                                            <Path Fill="{StaticResource TextBrush}"
                                                  Data="M3,17.25V21H6.75L17.8,9.95L14.05,6.2L3,17.25M20.7,7.05C21.1,6.65 21.1,6 20.7,5.6L18.4,3.3C18,2.9 17.35,2.9 16.95,3.3L15.15,5.1L18.9,8.85L20.7,7.05Z"/>
                                        </Viewbox>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MessageHoverActionButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanShowMessageActions}" Value="True"/>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=MessageContainer}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="MessageHoverActions" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="MessageHoverActions" Property="Opacity" Value="1"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="GroupMembersPanel"
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed"
                        Margin="0,0,0,8"
                        Background="#EA22242A"
                        BorderBrush="#3A3D46"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="MEMBERS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>

