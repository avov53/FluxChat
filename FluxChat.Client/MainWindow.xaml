                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ServerChannelIconText"
                                                           Text="#"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border x:Name="ServerChannelUnreadBadge"
                                                        Grid.Column="2"
                                                        MinWidth="20"
                                                        Height="18"
                                                        Padding="5,0"
                                                        Margin="8,0,4,0"
                                                        CornerRadius="9"
                                                        Background="#ef4444"
                                                        Visibility="Collapsed"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UnreadBadgeText}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="ServerVoiceElapsedText"
                                                           Grid.Column="2"
                                                           Text="{Binding VoiceElapsedText}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="8,0,4,0"
                                                           Visibility="Collapsed"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Margin="4,0,0,0">
                                                <Button x:Name="ServerChannelInviteButton"
                                                        Tag="{Binding}"
                                                        Width="24"
                                                        Height="24"
                                                        Background="#333640"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Visibility="Collapsed"
                                                        ToolTip="Invite to channel"
                                                        Click="ServerChannelInviteButton_OnClick">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#4752c4"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="+"
                                                               Foreground="White"
                                                               FontSize="15"
                                                               FontWeight="Bold"/>
                                                </Button>
                                                <Button x:Name="ServerChannelManageButton"
                                                        Tag="{Binding}"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="4,0,0,0"
                                                        Background="#333640"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Visibility="Collapsed"
                                                        ToolTip="Channel settings"
                                                        Click="ServerChannelManageButton_OnClick">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#4752c4"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="&#xE713;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="White"
                                                               FontSize="12"/>
                                                </Button>
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl x:Name="ServerVoiceParticipantsList"
                                                          ItemsSource="{Binding VoiceParticipants}"
                                                          Visibility="Collapsed"
                                                          Margin="28,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="22"
                                                                    Height="22"
                                                                    CornerRadius="11"
                                                                    Background="#4b4f58"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding AvatarImageSource}"
                                                                           Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="{x:Type Image}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsAvatarImage}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                    <TextBlock Text="{Binding Initials}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="10"
                                                                               FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="{x:Type TextBlock}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsAvatarImage}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DisplayName}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsVoice}" Value="True">
                                                <Setter TargetName="ServerChannelIconText" Property="Text" Value="&#xE767;"/>
                                                <Setter TargetName="ServerChannelIconText" Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                <Setter TargetName="ServerChannelIconText" Property="FontSize" Value="12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVoiceActive}" Value="True">
                                                <Setter TargetName="ServerChannelIconText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVoiceTimerVisible}" Value="True">
                                                <Setter TargetName="ServerVoiceElapsedText" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                <Setter TargetName="ServerChannelUnreadBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasVoiceParticipants}" Value="True">
                                                <Setter TargetName="ServerVoiceParticipantsList" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanInvite}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ServerChannelInviteButton" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanManageChannels}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ServerChannelManageButton" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,12">
                <Border x:Name="ProfileFlyout"
                        Visibility="Collapsed"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,72"
                        Background="#E62F3138"
                        BorderBrush="#5c5f68"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="ProfileFlyoutName"
                                   Text="Loading"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ProfileFlyoutUserId"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ProfileFlyoutAddress"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,10"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border Height="1" Background="#45474f" Margin="0,0,0,8"/>

                        <Button Style="{StaticResource StatusMenuButton}"
                                Tag="Online"
                                Click="ProfileStatusButton_OnClick">
                            <DockPanel>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ProfileStatusOnlineText" Text="Online" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource StatusMenuButton}"
                                Tag="Idle"
                                Margin="0,3,0,0"
                                Click="ProfileStatusButton_OnClick">
                            <DockPanel>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource IdleBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ProfileStatusIdleText" Text="Idle" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource StatusMenuButton}"
                                Tag="DoNotDisturb"
                                Margin="0,3,0,0"
                                Click="ProfileStatusButton_OnClick">
                            <DockPanel>
                                <Ellipse Width="10" Height="10" Fill="#ed4245" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ProfileStatusDndText" Text="Do not disturb" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource StatusMenuButton}"
                                Tag="Offline"
                                Margin="0,3,0,0"
                                Click="ProfileStatusButton_OnClick">
                            <DockPanel>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource OfflineBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ProfileStatusOfflineText" Text="Offline" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>

                        <TextBlock x:Name="ProfileCustomStatusLabelText"
                                   Text="Custom status"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProfileCustomStatusInput"
                                     MaxLength="64"
                                     MinHeight="34"
                                     VerticalContentAlignment="Center"
                                     KeyDown="ProfileCustomStatusInput_OnKeyDown"/>
                            <Button x:Name="ProfileCustomStatusApplyButton"
                                    Grid.Column="2"
                                    Content="Set"
                                    MinWidth="48"
                                    Style="{StaticResource GhostButton}"
                                    Click="ProfileCustomStatusApplyButton_OnClick"/>
                        </Grid>

                        <Button x:Name="ProfileCopyUserIdButton"
                                Content="Copy User ID"
                                Margin="0,10,0,0"
                                Style="{StaticResource GhostButton}"
                                Click="CopyUserIdButton_OnClick"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ProfilePanel"
                        VerticalAlignment="Bottom"
                        Background="#CC2F3138"
                        BorderBrush="#4b4e57"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        MouseLeftButtonUp="ProfilePanel_OnMouseLeftButtonUp">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="18"
                                          ShadowDepth="0"
                                          Opacity="0.28"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="50" Height="50">
                            <Grid Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Clip>
                                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                                </Grid.Clip>
                                <Ellipse x:Name="ProfileAvatarColor" Fill="#5865f2"/>
                                <Image x:Name="ProfileAvatarImage"
                                       Visibility="Collapsed"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       RenderTransformOrigin="0.5,0.5"/>
                                <MediaElement x:Name="ProfileAvatarVideo"
                                              Visibility="Collapsed"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="UniformToFill"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              IsMuted="True"
                                              Volume="0"
                                              RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                            <Ellipse x:Name="ProfileStatusRing"
                                     Stroke="{StaticResource SuccessBrush}"
                                     StrokeThickness="3"
                                     Fill="Transparent"/>
                            <TextBlock x:Name="ProfileInitialsText"
                                       Text="ME"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DisplayNameText"
                                       Text="Loading"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <DockPanel Margin="0,4,0,0">
                                <Ellipse x:Name="ProfileStatusDot"
                                         Width="8"
                                         Height="8"
                                         Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="ProfileStatusText"
                                           Text="Online"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock x:Name="UserIdText"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource SubtleBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AddressText"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border x:Name="ProfileActivityChip"
                                Grid.Column="3"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="8,0,4,0"
                                Background="#323640"
                                BorderBrush="#4A4F5D"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="7,4">
                            <TextBlock x:Name="ProfileActivityText"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       MaxWidth="88"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <TextBlock Grid.Column="4"
                                   Text="^"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ConversationPanel" Grid.Column="1" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ChatHeaderRow" Height="58"/>
                <RowDefinition x:Name="ChatHeaderLineRow" Height="1"/>
                <RowDefinition x:Name="ChatBodyRow" Height="*"/>
                <RowDefinition x:Name="ComposerRow" Height="Auto"/>
            </Grid.RowDefinitions>

