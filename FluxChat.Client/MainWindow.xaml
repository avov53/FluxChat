                                                <StackPanel>
                                                    <TextBlock Text="Direct chats" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="CustomizationDirectChatsPathText" Text="Default background" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ComboBox x:Name="CustomizationDirectChatsModeCombo" Grid.Column="1" Height="34" SelectionChanged="CustomizationModeCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Fill" Tag="Fill"/>
                                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                                    <ComboBoxItem Content="Blur fill" Tag="BlurFill"/>
                                                </ComboBox>
                                                <Button Grid.Column="3" Content="Choose" Style="{StaticResource GhostButton}" Click="CustomizationChooseWallpaperButton_OnClick"/>
                                                <Button Grid.Column="5" Content="Reset" Style="{StaticResource GhostButton}" Click="CustomizationResetWallpaperButton_OnClick"/>
                                            </Grid>

                                            <Grid x:Name="CustomizationGroupChatsRow" Tag="GroupChats" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Group chats" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="CustomizationGroupChatsPathText" Text="Default background" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ComboBox x:Name="CustomizationGroupChatsModeCombo" Grid.Column="1" Height="34" SelectionChanged="CustomizationModeCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Fill" Tag="Fill"/>
                                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                                    <ComboBoxItem Content="Blur fill" Tag="BlurFill"/>
                                                </ComboBox>
                                                <Button Grid.Column="3" Content="Choose" Style="{StaticResource GhostButton}" Click="CustomizationChooseWallpaperButton_OnClick"/>
                                                <Button Grid.Column="5" Content="Reset" Style="{StaticResource GhostButton}" Click="CustomizationResetWallpaperButton_OnClick"/>
                                            </Grid>

                                            <Grid x:Name="CustomizationContactsSidebarRow" Tag="ContactsSidebar" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Contacts sidebar" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="CustomizationContactsSidebarPathText" Text="Default background" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ComboBox x:Name="CustomizationContactsSidebarModeCombo" Grid.Column="1" Height="34" SelectionChanged="CustomizationModeCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Fill" Tag="Fill"/>
                                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                                    <ComboBoxItem Content="Blur fill" Tag="BlurFill"/>
                                                </ComboBox>
                                                <Button Grid.Column="3" Content="Choose" Style="{StaticResource GhostButton}" Click="CustomizationChooseWallpaperButton_OnClick"/>
                                                <Button Grid.Column="5" Content="Reset" Style="{StaticResource GhostButton}" Click="CustomizationResetWallpaperButton_OnClick"/>
                                            </Grid>

                                            <Grid x:Name="CustomizationSettingsRow" Tag="Settings">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Settings" FontWeight="SemiBold"/>
