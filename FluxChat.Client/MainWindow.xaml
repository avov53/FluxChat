                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SettingsPasswordStatusText"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                                <Button x:Name="SettingsChangePasswordButton"
                                                        Grid.Column="2"
                                                        Content="Change password"
                                                        MinWidth="130"
                                                        Height="36"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Click="SettingsChangePasswordButton_OnClick"/>
                                            </Grid>
                                        </Grid>

                                        <Button x:Name="SettingsSignOutAllDevicesButton"
