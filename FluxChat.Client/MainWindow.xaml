                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ChatScrollBarStyle}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3"
                                          Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource FluxContextMenuStyle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Add friend" Click="GroupMemberAddFriendMenuItem_OnClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="17" Height="17">
                                                            <Path Style="{StaticResource ContextMenuIconPath}"
                                                                  Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10H6M15,12A4,4 0 1,0 15,4A4,4 0 0,0 15,12Z"/>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanAddFriend}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="Rename contact" Click="GroupMemberRenameContactMenuItem_OnClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="17" Height="17">
                                                            <Path Style="{StaticResource ContextMenuIconPath}"
                                                                  Data="M3,17.25V21H6.75L17.8,9.95L14.05,6.2L3,17.25M20.7,7.05C21.1,6.65 21.1,6 20.7,5.6L18.4,3.3C18,2.9 17.35,2.9 16.95,3.3L15.15,5.1L18.9,8.85L20.7,7.05Z"/>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRenameContact}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="Write message" Click="GroupMemberWriteMessageMenuItem_OnClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="17" Height="17">
                                                            <Path Style="{StaticResource ContextMenuIconPath}"
                                                                  Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2Z"/>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanWriteMessage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="Make server owner" Click="GroupMemberMakeOwnerMenuItem_OnClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="17" Height="17">
                                                            <Path Style="{StaticResource ContextMenuIconPath}"
                                                                  Data="M5,16L3,5L8.5,10L12,4L15.5,10L21,5L19,16H5M19,19H5V21H19V19Z"/>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanMakeOwner}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="Remove from server" Click="GroupMemberRemoveMenuItem_OnClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="17" Height="17">
                                                            <Path Style="{StaticResource ContextMenuDangerIconPath}"
                                                                  Data="M12,5A3.5,3.5 0 1,0 12,12A3.5,3.5 0 0,0 12,5M12,14C8.13,14 5,15.79 5,18V19H14.53C14.19,18.41 14,17.73 14,17C14,15.9 14.45,14.9 15.17,14.17C14.23,14.06 13.16,14 12,14M18,14L20,16L22,14L23.5,15.5L21.5,17.5L23.5,19.5L22,21L20,19L18,21L16.5,19.5L18.5,17.5L16.5,15.5L18,14Z"/>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRemoveFromGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="Ban from server" Click="GroupMemberBanMenuItem_OnClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="17" Height="17">
                                                            <Path Style="{StaticResource ContextMenuDangerIconPath}"
                                                                  Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M4,12A8,8 0 0,1 17.5,6.2L6.2,17.5A7.96,7.96 0 0,1 4,12M12,20A7.96,7.96 0 0,1 7.6,18.8L18.8,7.6A8,8 0 0,1 12,20Z"/>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRemoveFromGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <TextBlock Text="{Binding RoleGroupName}"
                                                   Foreground="{Binding RoleGroupColor}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="2,0,0,4">
