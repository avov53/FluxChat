                                    <DockPanel>
                                        <TextBlock Text="A"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="0,0,10,0"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsLanguageTabText" Text="Language" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsPrivacyTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsPrivacyTabButton_OnClick">
                                    <DockPanel>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsPrivacyTabText" Text="Privacy" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsActivityTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsActivityTabButton_OnClick">
                                    <DockPanel>
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsActivityTabText" Text="Activity" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsNotificationsTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsNotificationsTabButton_OnClick">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsNotificationsTabText" Text="Notifications" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsDataTabButton" Visibility="Collapsed"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsDataTabButton_OnClick">
                                    <DockPanel>
                                        <TextBlock Text="&#x2601;" FontFamily="Segoe UI Symbol" FontSize="15" Margin="0,0,10,0"/>
                                        <TextBlock Text="Data" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsSignOutTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsSignOutTabButton_OnClick">
                                    <DockPanel>
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock x:Name="SettingsSignOutTabText" Text="Sign out" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsCustomizationTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsCustomizationTabButton_OnClick">
                                    <DockPanel>
                                        <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="SettingsCustomizationTabText" Text="Customization" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    x:Name="SettingsCloseSidebarButton"
                                    Content="Close"
                                    Margin="10,0,10,14"
                                    Style="{StaticResource GhostButton}"
                                    Click="SettingsCloseButton_OnClick"/>
                        </Grid>

                        <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>

                        <Grid Grid.Column="2" Margin="24,20,24,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel x:Name="SettingsAccountHeader">
                                <Button DockPanel.Dock="Right"
                                        Width="34"
                                        Height="34"
                                        Content="x"
                                        Style="{StaticResource GhostButton}"
                                        Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsAccountTitleText"
                                               Text="Account"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsAccountSubtitleText"
                                               Text="Your profile and VPS relay connection."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsVoiceHeader"
                                       Visibility="Collapsed">
                                <Button DockPanel.Dock="Right"
                                        Width="34"
                                        Height="34"
                                        Content="x"
                                        Style="{StaticResource GhostButton}"
                                        Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsVoiceTitleText"
                                               Text="Voice"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsVoiceSubtitleText"
                                               Text="Microphone, headphones and local voice check."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsDataHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock Text="Data" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="Choose where FluxChat keeps conversations and attachments."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsSignOutHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsSignOutTitleText" Text="Sign out" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsSignOutSubtitleText" Text="Leave this account on this device."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsCustomizationHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsCustomizationTitleText" Text="Customization" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsCustomizationSubtitleText" Text="Local wallpapers, message sounds and call ringtones."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsLanguageHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsLanguageTitleText" Text="Language" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsLanguageSubtitleText" Text="Choose the interface language for this device."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsPrivacyHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsPrivacyTitleText" Text="Privacy" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsPrivacySubtitleText" Text="Control who can contact you and what profile data they can see."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsActivityHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsActivityTitleText" Text="Activity" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsActivitySubtitleText" Text="Game activity and scheduled Do Not Disturb."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel x:Name="SettingsNotificationsHeader" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Width="34" Height="34" Content="x"
                                        Style="{StaticResource GhostButton}" Click="SettingsCloseButton_OnClick"/>
                                <StackPanel>
                                    <TextBlock x:Name="SettingsNotificationsTitleText" Text="Notifications" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="SettingsNotificationsSubtitleText" Text="Choose how FluxChat alerts you."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <ScrollViewer x:Name="SettingsAccountContent"
                                          Grid.Row="2"
                                          Grid.RowSpan="2"
                                          VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="64" Height="64">
                                            <Grid.Clip>
                                                <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                                            </Grid.Clip>
                                            <Ellipse x:Name="SettingsAvatarPreview"
                                                     Fill="#5865f2"/>
                                            <Image x:Name="SettingsAvatarImage"
                                                   Visibility="Collapsed"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   RenderTransformOrigin="0.5,0.5"/>
                                            <MediaElement x:Name="SettingsAvatarVideo"
                                                          Visibility="Collapsed"
                                                          LoadedBehavior="Manual"
                                                          UnloadedBehavior="Manual"
                                                          Stretch="UniformToFill"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          IsMuted="True"
                                                          Volume="0"
                                                          RenderTransformOrigin="0.5,0.5"/>
                                            <TextBlock x:Name="SettingsAvatarInitials"
                                                       Text="ME"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="17"
                                                       FontWeight="Bold"/>
                                        </Grid>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock x:Name="SettingsProfileSectionTitleText"
                                                       Text="PROFILE"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>

                                            <TextBox x:Name="SettingsDisplayNameInput"
                                                     Grid.Row="2"
                                                     MinHeight="38"
                                                     ToolTip="Nickname"/>

                                            <StackPanel Grid.Row="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="SettingsChooseAvatarImageButton"
                                                            Content="Image"
                                                            Height="28"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource GhostButton}"
                                                            Click="ChooseAvatarImageButton_OnClick"/>
                                                    <Button x:Name="SettingsChooseAvatarVideoButton"
                                                            Content="Video"
                                                            Height="28"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource GhostButton}"
                                                            Click="ChooseAvatarVideoButton_OnClick"/>
                                                    <Button x:Name="SettingsSaveProfileButton"
                                                            Content="Save profile"
                                                            Height="28"
                                                            Style="{StaticResource GhostButton}"
                                                            Click="SaveProfileButton_OnClick"/>
                                                </StackPanel>
                                                <Grid x:Name="InlineAvatarCropPanel"
                                                      Visibility="Collapsed"
                                                      Margin="0,12,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="SettingsAvatarZoomLabelText" Text="Zoom" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Slider x:Name="SettingsAvatarZoomSlider" Grid.Column="1" Minimum="1" Maximum="3" Value="1" ValueChanged="AvatarCropSlider_OnValueChanged"/>
                                                    <TextBlock x:Name="SettingsAvatarHorizontalLabelText" Grid.Row="2" Text="Horizontal" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Slider x:Name="SettingsAvatarOffsetXSlider" Grid.Row="2" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" ValueChanged="AvatarCropSlider_OnValueChanged"/>
                                                    <TextBlock x:Name="SettingsAvatarVerticalLabelText" Grid.Row="4" Text="Vertical" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Slider x:Name="SettingsAvatarOffsetYSlider" Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" ValueChanged="AvatarCropSlider_OnValueChanged"/>
                                                    <TextBlock x:Name="SettingsAvatarStartLabelText" Grid.Row="6" Text="Start" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Slider x:Name="SettingsAvatarVideoStartSlider" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="60" Value="0" ValueChanged="AvatarVideoSlider_OnValueChanged"/>
                                                    <TextBlock x:Name="SettingsAvatarLengthLabelText" Grid.Row="8" Text="Length" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Slider x:Name="SettingsAvatarVideoDurationSlider" Grid.Row="8" Grid.Column="1" Minimum="1" Maximum="10" Value="10" ValueChanged="AvatarVideoSlider_OnValueChanged"/>
                                                </Grid>
                                                <TextBlock x:Name="SettingsAvatarVideoHint"
                                                           Text="Animated avatars loop up to 10 seconds."
                                                           Foreground="{StaticResource SubtleBrush}"
                                                           FontSize="11"
                                                           Margin="0,8,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Width="28" Height="28" Margin="0,0,8,0" Tag="#5865f2" Click="AvatarColorButton_OnClick">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="#5865f2" CornerRadius="14"/></ControlTemplate></Button.Template>
                                                </Button>
                                                <Button Width="28" Height="28" Margin="0,0,8,0" Tag="#23a55a" Click="AvatarColorButton_OnClick">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="#23a55a" CornerRadius="14"/></ControlTemplate></Button.Template>
                                                </Button>
                                                <Button Width="28" Height="28" Margin="0,0,8,0" Tag="#f0b232" Click="AvatarColorButton_OnClick">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="#f0b232" CornerRadius="14"/></ControlTemplate></Button.Template>
                                                </Button>
                                                <Button Width="28" Height="28" Margin="0,0,8,0" Tag="#eb459e" Click="AvatarColorButton_OnClick">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="#eb459e" CornerRadius="14"/></ControlTemplate></Button.Template>
                                                </Button>
                                                <Button Width="28" Height="28" Margin="0,0,8,0" Tag="#ed4245" Click="AvatarColorButton_OnClick">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="#ed4245" CornerRadius="14"/></ControlTemplate></Button.Template>
                                                </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="SettingsScreenShareMiniPlayerTitleText"
                                                       Text="SCREEN SHARE MINI PLAYER"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="SettingsScreenShareMiniPlayerBodyText"
                                                       Text="Keep the screen share mini-player visible outside FluxChat."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,5,18,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SettingsKeepScreenShareMiniPlayerCheck"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SmoothCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Checked="SettingsKeepScreenShareMiniPlayerCheck_OnChanged"
                                                  Unchecked="SettingsKeepScreenShareMiniPlayerCheck_OnChanged"/>
                                    </Grid>
                                </Border>

                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="SettingsDiagnosticLoggingTitleText"
                                                       Text="DIAGNOSTIC LOGGING"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="SettingsDiagnosticLoggingBodyText"
                                                       Text="Save detailed app logs while debugging. Crash logs are always saved."
                                                       Margin="0,6,18,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SettingsDetailedLoggingCheck"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SmoothCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Checked="SettingsDetailedLoggingCheck_OnChanged"
                                                  Unchecked="SettingsDetailedLoggingCheck_OnChanged"/>
                                    </Grid>
                                </Border>

                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="SettingsVpsServerTitleText"
                                                   Text="VPS SERVER"
                                                   Foreground="{StaticResource SubtleBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SettingsServerAddressInput"
                                                     MinHeight="38"
                                                     ToolTip="host:port"/>
                                            <Button x:Name="SettingsLinkServerButton"
                                                    Grid.Column="2"
                                                    Content="Link"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="ConnectServerButton_OnClick"/>
                                        </Grid>

                                        <TextBox x:Name="SettingsServerAccessKeyInput"
                                                 Grid.Row="4"
                                                 MinHeight="38"
                                                 ToolTip="Invite code or saved token"/>

                                        <Button x:Name="SettingsVpsHelpButton"
                                                Grid.Row="6"
                                                Content="VPS help"
                                                Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="VpsHelpButton_OnClick"/>
                                    </Grid>
                                </Border>

                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock x:Name="SettingsSecurityTitleText"
                                                           Text="SECURITY"
                                                           Foreground="{StaticResource SubtleBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                                <TextBlock x:Name="SettingsSecurityBodyText"
                                                           Text="Active devices and account password."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="SettingsSecurityRefreshButton"
                                                    DockPanel.Dock="Right"
                                                    Content="Refresh"
                                                    MinWidth="84"
                                                    Height="32"
                                                    Style="{StaticResource GhostButton}"
                                                    Click="SettingsSecurityRefreshButton_OnClick"/>
                                        </DockPanel>

                                        <TextBlock x:Name="SettingsSecurityStatusText"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,12,0,8"/>

                                        <ItemsControl x:Name="SettingsDeviceSessionsList"
                                                      ItemsSource="{Binding}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#25272f"
                                                            BorderBrush="#3f424b"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="28"
                                                                    Height="28"
                                                                    CornerRadius="8"
                                                                    Background="#3a3d46"
                                                                    VerticalAlignment="Center">
                                                                <Grid Width="17"
                                                                      Height="17"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                                    <Border Width="13"
                                                                            Height="9"
                                                                            CornerRadius="1.8"
                                                                            BorderBrush="#eef2ff"
                                                                            BorderThickness="1.4"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,1,0,0"/>
                                                                    <Rectangle Width="5"
                                                                               Height="1.4"
                                                                               RadiusX="0.7"
                                                                               RadiusY="0.7"
