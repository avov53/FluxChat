                                            <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0" Background="#eb459e" BorderBrush="#ff72ba" BorderThickness="1" Tag="#eb459e" ToolTip="Pink" Click="ServerRoleColorSwatch_OnClick" Style="{StaticResource GhostButton}"/>
