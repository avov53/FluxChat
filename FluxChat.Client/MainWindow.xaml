                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="NOTIFICATION SOUNDS"
                                                               Foreground="{StaticResource SubtleBrush}"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="Custom local sounds for incoming calls and messages."
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="12"
                                                               Margin="0,6,12,12"/>
