                            <StackPanel Grid.Row="1" Margin="10,0">
                                <Button x:Name="SettingsAccountTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="#404249"
                                        HorizontalContentAlignment="Left"
                                        Click="SettingsAccountTabButton_OnClick">
                                    <DockPanel>
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Fill="{StaticResource AccentBrush}"
                                                 Margin="0,0,10,0"/>
                                        <TextBlock x:Name="SettingsAccountTabText" Text="Account" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsVoiceTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
                                        Click="SettingsVoiceTabButton_OnClick">
                                    <DockPanel>
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Fill="#949ba4"
                                                 Margin="0,0,10,0"/>
                                        <TextBlock x:Name="SettingsVoiceTabText" Text="Voice" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="SettingsLanguageTabButton"
                                        Style="{StaticResource StatusMenuButton}"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,6,0,0"
