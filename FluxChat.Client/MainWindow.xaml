                                            <TextBlock x:Name="ActivityVisibilityTitleText" Text="WHO CAN SEE YOUR ACTIVITY" Foreground="{StaticResource SubtleBrush}" FontSize="11" FontWeight="Bold"/>
                                            <ComboBox x:Name="ActivityVisibilityCombo" Height="36" Margin="0,12,0,0" SelectionChanged="ActivityVisibilityCombo_OnSelectionChanged">
                                                <ComboBoxItem Content="Friends" Tag="Friends"/>
                                                <ComboBoxItem Content="Everyone" Tag="Everyone"/>
