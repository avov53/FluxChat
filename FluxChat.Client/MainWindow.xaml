                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowRoleGroupHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Row="1"
                                                CornerRadius="7"
                                                Padding="6"
                                                Background="#23252B">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="32" Height="32">
                                                    <Border CornerRadius="16" Background="#4e5058"/>
                                                    <Grid>
                                                        <Grid.Clip>
                                                            <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/>
                                                        </Grid.Clip>
                                                        <Image Source="{Binding AvatarImageSource}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAvatarImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <MediaElement LoadedBehavior="Manual"
                                                                      UnloadedBehavior="Stop"
                                                                      Loaded="AvatarVideo_OnLoaded"
                                                                      MediaEnded="AvatarVideo_OnMediaEnded"
                                                                      Stretch="UniformToFill"
                                                                      IsMuted="True"
                                                                      Volume="0">
                                                            <MediaElement.Style>
                                                                <Style TargetType="MediaElement">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAvatarVideo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MediaElement.Style>
                                                        </MediaElement>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{Binding DisplayNameColor}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ShortId}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="10"
                                                               Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding RoleSummary}"
                                                               Foreground="#9fb1ff"
                                                               FontSize="10"
                                                               Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRoleSummary}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <DockPanel Margin="0,2,0,0">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Fill="{Binding StatusColor}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ActivityText}"
                                                               Foreground="#B7C4FF"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasActivity}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3"
                                                           Text="♛"
                                                           FontSize="14"
                                                           Foreground="#f6c65b"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOwner}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ComposerPanel"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Padding="20,10,20,22"
                    Background="{StaticResource PanelBrush}"
                    AllowDrop="True"
                    PreviewDragOver="ComposerPanel_OnPreviewDragOver"
                    Drop="ComposerPanel_OnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="ReplyEditBar"
                            Visibility="Collapsed"
                            Background="#25272d"
                            BorderBrush="#45474f"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,7"
                            Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="x"
                                    Width="28"
                                    Height="26"
                                    Padding="0"
                                    Style="{StaticResource GhostButton}"
                                    Click="ClearReplyEditButton_OnClick"/>
                            <StackPanel>
                                <TextBlock x:Name="ReplyEditTitleText"
                                           Text="Replying"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <TextBlock x:Name="ReplyEditPreviewText"
                                           Text=""
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="ImageDraftBar"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="#25272d"
                            BorderBrush="#45474f"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
