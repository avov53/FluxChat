                                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                                    <ComboBoxItem Content="Blur fill" Tag="BlurFill"/>
                                                </ComboBox>
                                                <Button Grid.Column="3" Content="Choose" Style="{StaticResource GhostButton}" Click="CustomizationChooseWallpaperButton_OnClick"/>
                                                <Button Grid.Column="5" Content="Reset" Style="{StaticResource GhostButton}" Click="CustomizationResetWallpaperButton_OnClick"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="0,14,0,0">
