        <Border x:Name="ScreenShareMiniDismissZone"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Panel.ZIndex="43"
                Width="128"
                Height="128"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#CC15171b"
                BorderBrush="#f87171"
                BorderThickness="1"
                CornerRadius="64"
                Opacity="0"
                IsHitTestVisible="False">
            <Grid>
                <Path Stroke="#ffb4b4"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M44,44 L84,84 M84,44 L44,84"/>
            </Grid>
        </Border>

        <Border x:Name="ScreenShareMiniPlayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Panel.ZIndex="44"
                Width="320"
                Height="180"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#111214"
                BorderBrush="#545763"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True"
                Cursor="SizeAll"
                MouseLeftButtonDown="ScreenShareMiniPlayer_OnMouseLeftButtonDown"
                MouseMove="ScreenShareMiniPlayer_OnMouseMove"
                MouseLeftButtonUp="ScreenShareMiniPlayer_OnMouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Image x:Name="ScreenShareMiniPlayerImage"
                       Stretch="UniformToFill"/>
                <Border x:Name="ScreenShareMiniPlayerPlaceholder"
                        Background="#202329">
                    <TextBlock Text="Screen share preview"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border Background="#A0000000"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="8,4"
                        CornerRadius="5">
                    <TextBlock x:Name="ScreenShareMiniPlayerTitleText"
                               Text="Screen share"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#f2f3f5"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button x:Name="ScreenShareMiniPlayerCloseButton"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Content="x"
                        Style="{StaticResource GhostButton}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        ToolTip="Hide mini-player"
                        Click="ScreenShareMiniPlayerCloseButton_OnClick"/>
            </Grid>
        </Border>

        <Canvas x:Name="MiniProfileLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Panel.ZIndex="44"
                Background="Transparent"
                MouseLeftButtonDown="MiniProfileLayer_OnMouseLeftButtonDown">
            <Border x:Name="MiniProfileCard"
                    Width="340"
                    Height="360"
                    Padding="18"
                    CornerRadius="20"
                    Background="#2b2d31"
                    BorderBrush="#4b4e58"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonDown="MiniProfileCard_OnMouseLeftButtonDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.38"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Height="78"
                                Margin="58,12,0,0"
                                CornerRadius="39"
                                Background="#3a3d45"
                                BorderBrush="#60636d"
                                BorderThickness="1.5">
                            <Grid Margin="88,0,22,0"
                                  VerticalAlignment="Center">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="21"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="148"/>
                                        <Border Width="9"
                                                Height="9"
                                                Margin="7,11,0,0"
                                                CornerRadius="4.5"
                                                Background="{Binding StatusBrush}"
                                                ToolTip="{Binding StatusText}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ShortUserId}"
                                               Margin="0,2,0,0"
                                               FontSize="21"
                                               Foreground="#d7d9df"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Width="96"
                              Height="96"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0">
                            <Border CornerRadius="48"
                                    Background="#4e5058"
                                    BorderBrush="#6c6f78"
                                    BorderThickness="2"/>
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48"/>
                                </Grid.Clip>
                                <Image Source="{Binding AvatarImageSource}"
                                       Stretch="UniformToFill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvatarImage}" Value="True">
