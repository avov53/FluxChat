                                          BorderBrush="#4b4e57"
                                          Foreground="{StaticResource TextBrush}"
                                          ToolTip="Server template">
                                    <ComboBoxItem Tag="empty" Content="Empty"/>
                                    <ComboBoxItem Tag="friends" Content="Friends"/>
                                    <ComboBoxItem Tag="gaming" Content="Gaming"/>
                                    <ComboBoxItem Tag="community" Content="Community"/>
                                    <ComboBoxItem Tag="study" Content="Study / Учеба"/>
                                    <ComboBoxItem Tag="work" Content="Work / Работа"/>
                                </ComboBox>

                                <Border Grid.Row="8"
                                        Height="42"
                                        Width="360"
                                        HorizontalAlignment="Center"
                                        Background="#383a40"
                                        BorderBrush="#4b4e57"
                                        BorderThickness="1"
                                        CornerRadius="21">
                                    <Grid>
                                        <TextBox x:Name="GroupSearchInput"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="16,9"
                                                 Foreground="{StaticResource TextBrush}"
                                                 CaretBrush="{StaticResource TextBrush}"
                                                 ToolTip="Search friend"
                                                 TextChanged="GroupSearchInput_OnTextChanged"/>
                                    </Grid>
                                </Border>

                                <ListBox x:Name="GroupFriendsList"
                                         Grid.Row="10"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="42" Height="42">
                                                    <Border CornerRadius="21" Background="#4e5058"/>
                                                    <Grid>
                                                        <Grid.Clip>
                                                            <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21"/>
                                                        </Grid.Clip>
                                                        <Image Source="{Binding AvatarImageSource}"
                                                               Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAvatarImage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <MediaElement LoadedBehavior="Manual"
                                                                      UnloadedBehavior="Stop"
                                                                      Loaded="AvatarVideo_OnLoaded"
                                                                      MediaEnded="AvatarVideo_OnMediaEnded"
                                                                      Stretch="UniformToFill"
                                                                      IsMuted="True"
                                                                      Volume="0">
                                                            <MediaElement.Style>
                                                                <Style TargetType="MediaElement">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAvatarVideo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MediaElement.Style>
                                                        </MediaElement>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ShortId}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                        Width="86"
                                                        Height="32"
                                                        Content="{Binding GroupActionText}"
                                                        IsEnabled="{Binding CanAdd}"
                                                        Style="{StaticResource GhostButton}"
                                                        Click="AddGroupMemberButton_OnClick"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="GroupCreateStatusText"
                                           Grid.Row="12"
                                           Text="Можно добавить до 10 друзей."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextAlignment="Center"/>
                                <Button x:Name="CreateServerNowButton"
                                        Grid.Row="6"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,2"
                                        Content="Create server"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="CreateServerNowButton_OnClick"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="AddFriendPanel"
                        Grid.RowSpan="3"
                        Grid.ColumnSpan="3"
                        Visibility="Collapsed"
                        Panel.ZIndex="5"
                        Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,54,0,0"
                        Background="#2b2d31"
                        BorderBrush="#45474f"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="AddFriendTitleText"
                                   Text="Add Friend"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="AddFriendSubtitleText"
                                   Grid.Row="2"
                                   Text="Enter a User ID or UserId@host:port."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"/>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AddFriendInput"
                                     MinHeight="42"
                                     ToolTip="Friend UserId or UserId@host:port"/>
                            <Button Grid.Column="2"
                                    x:Name="AddFriendSubmitButton"
                                    Content="Add"
                                    Height="42"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddContactButton_OnClick"/>
                        </Grid>

                        <TextBlock x:Name="IncomingFriendRequestsTitleText"
                                   Grid.Row="6"
                                   Text="Incoming friend requests"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <ListBox x:Name="FriendRequestsList"
                                 Grid.Row="8"
                                 MaxHeight="170">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="38" Height="38">
                                            <Border CornerRadius="19" Background="#4e5058"/>
                                            <Grid>
                                                <Grid.Clip>
                                                    <EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/>
                                                </Grid.Clip>
                                                <Image Source="{Binding AvatarImageSource}"
                                                       Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvatarImage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <MediaElement LoadedBehavior="Manual"
                                                              UnloadedBehavior="Stop"
                                                              Loaded="AvatarVideo_OnLoaded"
                                                              MediaEnded="AvatarVideo_OnMediaEnded"
                                                              Stretch="UniformToFill"
                                                              IsMuted="True"
                                                              Volume="0">
                                                    <MediaElement.Style>
                                                        <Style TargetType="MediaElement">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvatarVideo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MediaElement.Style>
                                                </MediaElement>
                                            </Grid>
                                            <TextBlock Text="{Binding Initials}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding UserId}"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                Content="Accept"
                                                Height="32"
                                                Style="{StaticResource GhostButton}"
                                                Click="AcceptFriendRequestButton_OnClick"/>
                                        <Button Grid.Column="5"
                                                Content="Decline"
                                                Height="32"
                                                Style="{StaticResource GhostButton}"
                                                Click="DeclineFriendRequestButton_OnClick"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border x:Name="UnusedServerChannelsPanel"
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="204"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Panel.ZIndex="8"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#343741"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0"
                        Padding="10,14,10,10"
                        Margin="-214,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="0"
                                          Opacity="0.14"
                                          Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Border Width="1"
                                HorizontalAlignment="Left"
                                Margin="-10,8,0,8"
                                CornerRadius="1"
                                Background="#3f424b"
                                Opacity="0.9"/>
                        <DockPanel Margin="8,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="CHANNELS"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Server space"
                                       Foreground="{StaticResource SubtleBrush}"
                                       FontSize="10"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="UnusedServerChannelsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="ChannelItemBorder"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        Padding="8,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ChannelItemBorder" Property="Background" Value="#343741"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ChannelItemBorder" Property="Background" Value="#40435f"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyChatHint"
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38" Background="#404249">
                        <TextBlock Text="#"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SubtleBrush}"/>
                    </Border>
                    <TextBlock Text="No conversation selected"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Pick a contact from Direct Messages."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ListBox x:Name="MessagesList"
                         Grid.Row="2"
                         Grid.Column="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.PanningMode="VerticalOnly"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AllowDrop="True"
                         PreviewDragOver="ComposerPanel_OnPreviewDragOver"
                         Drop="ComposerPanel_OnDrop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactContinuation}" Value="True">
                                    <Setter Property="Margin" Value="0,-3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ChatScrollBarStyle}"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="MessageContainer"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="0,1,0,1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactContinuation}" Value="True">
                                                <Setter Property="Margin" Value="0,-1,0,-1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                                                <Setter Property="Margin" Value="0,10,0,2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid Grid.Column="0"
                                      Width="40"
                                      Height="40"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Cursor="Hand"
                                      MouseLeftButtonUp="MessageAvatar_OnMouseLeftButtonUp">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowSenderAvatar}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border CornerRadius="20" Background="#4e5058"/>
                                    <Grid>
                                        <Grid.Clip>
                                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                        </Grid.Clip>
                                        <Image Source="{Binding SenderAvatarImageSource}"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSenderAvatarImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <MediaElement LoadedBehavior="Manual"
                                                      UnloadedBehavior="Stop"
                                                      Loaded="AvatarVideo_OnLoaded"
                                                      MediaEnded="AvatarVideo_OnMediaEnded"
                                                      Stretch="UniformToFill"
                                                      IsMuted="True"
                                                      Volume="0">
                                            <MediaElement.Style>
                                                <Style TargetType="MediaElement">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSenderAvatarVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MediaElement.Style>
                                        </MediaElement>
                                    </Grid>
                                    <TextBlock Text="{Binding SenderInitials}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSenderAvatarImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSenderAvatarVideo}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="MessageHoverTime"
                                           Grid.Column="0"
                                           Text="{Binding HoverTimeText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCompactContinuation}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=MessageContainer}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border x:Name="MessageBubble"
                                        Grid.Column="2"
                                        MaxWidth="720"
                                        CornerRadius="8">
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource FluxContextMenuStyle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Add reaction" Click="MessageAddReactionMenuItem_OnClick">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="17" Height="17">
                                                        <Path Style="{StaticResource ContextMenuIconPath}"
                                                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M8.5,8A1.5,1.5 0 0,1 10,9.5A1.5,1.5 0 0,1 8.5,11A1.5,1.5 0 0,1 7,9.5A1.5,1.5 0 0,1 8.5,8M15.5,8A1.5,1.5 0 0,1 17,9.5A1.5,1.5 0 0,1 15.5,11A1.5,1.5 0 0,1 14,9.5A1.5,1.5 0 0,1 15.5,8M12,17.5C9.67,17.5 7.69,16.04 6.89,14H17.11C16.31,16.04 14.33,17.5 12,17.5Z"/>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanShowMessageActions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Reply" Click="MessageReplyMenuItem_OnClick">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="17" Height="17">
                                                        <Path Style="{StaticResource ContextMenuIconPath}"
                                                              Data="M10,9V5L3,12L10,19V14.9C15,14.9 18.5,16.5 21,20C20,15 17,10 10,9Z"/>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanShowMessageActions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
