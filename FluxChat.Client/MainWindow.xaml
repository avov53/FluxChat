                                            CornerRadius="8" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="SIGN OUT OF FLUXCHAT"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
