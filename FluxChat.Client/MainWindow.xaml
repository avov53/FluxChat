                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="#"
                           Foreground="{StaticResource SubtleBrush}"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

