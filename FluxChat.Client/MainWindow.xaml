                                                Margin="0,14,0,0"
                                                Style="{StaticResource GhostButton}"
                                                Click="SettingsSignOutAllDevicesButton_OnClick"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SettingsVoiceContent"
                                          Grid.Row="2"
                                          Grid.RowSpan="2"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="SettingsVoiceSectionTitleText"
                                                   Text="VOICE"
                                                   Foreground="{StaticResource SubtleBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2"
                                                   x:Name="SettingsVoiceInputLabelText"
                                                   Text="Input device"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                        <ComboBox x:Name="SettingsAudioInputDeviceCombo"
                                                  Grid.Row="4"
                                                  MinHeight="36"
                                                  SelectionChanged="SettingsAudioDeviceCombo_OnSelectionChanged"/>

                                        <TextBlock Grid.Row="6"
                                                   x:Name="SettingsVoiceOutputLabelText"
                                                   Text="Output device"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"/>
                                        <ComboBox x:Name="SettingsAudioOutputDeviceCombo"
                                                  Grid.Row="8"
                                                  MinHeight="36"
                                                  SelectionChanged="SettingsAudioDeviceCombo_OnSelectionChanged"/>

                                        <StackPanel Grid.Row="10"
                                                    Orientation="Horizontal"
                                                    Margin="0,14,0,0">
                                            <Button x:Name="VoiceTestButton"
                                                    Content="Check voice"
                                                    Height="32"
                                                    MinWidth="120"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="VoiceTestButton_OnClick"/>
                                            <TextBlock x:Name="VoiceTestStatusText"
                                                       Text="Speak to hear yourself."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Row="12"
                                                Padding="12"
                                                Background="#2b2d31"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="SettingsNoiseSuppressionTitleText"
                                                               Text="Noise suppression"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="SettingsNoiseSuppressionBodyText"
                                                               Text="Reduces keyboard and steady background noise."
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"
                                                               Margin="0,3,12,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="SettingsNoiseSuppressionCheck"
                                                          Grid.Column="1"
                                                          Style="{StaticResource SmoothCheckBox}"
                                                          VerticalAlignment="Center"
                                                          Checked="SettingsNoiseSuppressionCheck_OnChanged"
                                                          Unchecked="SettingsNoiseSuppressionCheck_OnChanged"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="#313338"
                                        BorderBrush="#45474f"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="PUSH TO TALK"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Microphone is sent only while the selected key is held."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,5,18,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SettingsPushToTalkCheck"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SmoothCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Checked="SettingsPushToTalkCheck_OnChanged"
                                                  Unchecked="SettingsPushToTalkCheck_OnChanged"/>

                                        <Button x:Name="SettingsPushToTalkKeyButton"
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                MinWidth="160"
                                                Content="LeftCtrl"
                                                Style="{StaticResource GhostButton}"
                                                Click="SettingsPushToTalkKeyButton_OnClick"
                                                PreviewKeyDown="SettingsPushToTalkKeyButton_OnPreviewKeyDown"/>
                                        <TextBlock x:Name="SettingsPushToTalkHintText"
                                                   Grid.Row="4"
                                                   Grid.ColumnSpan="2"
                                                   Text="Disabled by default."
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SettingsDataContent"
                                          Grid.Row="2"
                                          Grid.RowSpan="2"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1"
                                            CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="STORAGE" Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11" FontWeight="Bold"/>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Chat history" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Local remains the primary cache in this version."
                                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,12,0"/>
                                                </StackPanel>
                                                <ComboBox x:Name="SettingsChatStorageCombo" Grid.Column="1"
                                                          SelectionChanged="SettingsDataStorageCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Local computer" Tag="LocalComputer"/>
                                                    <ComboBoxItem Content="Google Drive backup" Tag="GoogleDrive"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Images" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Choose local storage or Drive backup."
                                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,12,0"/>
                                                </StackPanel>
                                                <ComboBox x:Name="SettingsImageStorageCombo" Grid.Column="1"
                                                          SelectionChanged="SettingsDataStorageCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Local computer" Tag="LocalComputer"/>
                                                    <ComboBoxItem Content="Google Drive" Tag="GoogleDrive"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Videos and files" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Files up to 5 GB are uploaded directly to your Drive."
                                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,12,0"/>
                                                </StackPanel>
                                                <ComboBox x:Name="SettingsFileStorageCombo" Grid.Column="1"
                                                          SelectionChanged="SettingsDataStorageCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Google Drive" Tag="GoogleDrive"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="GOOGLE DRIVE" Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11" FontWeight="Bold"/>
                                            <TextBlock x:Name="GoogleDriveStatusText" Text="Not connected"
                                                       Margin="0,8,0,0" FontWeight="SemiBold"/>
                                            <TextBlock Text="FluxChat requests drive.file access and can only manage files created by FluxChat."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <TextBox x:Name="GoogleDriveClientIdInput" MinHeight="36"
                                                     ToolTip="Google OAuth Desktop client ID (public identifier)"/>
                                            <TextBlock Text="OAuth client ID is needed for self-built public releases; no private client secret is stored in FluxChat."
                                                       Foreground="{StaticResource SubtleBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="GoogleDriveConnectButton" Content="Connect Google Drive"
                                                        Style="{StaticResource PrimaryButton}" Click="GoogleDriveConnectButton_OnClick"/>
                                                <Button x:Name="GoogleDriveDisconnectButton" Content="Disconnect"
                                                        Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                                        Visibility="Collapsed" Click="GoogleDriveDisconnectButton_OnClick"/>
                                                <Button x:Name="GoogleDriveBackupButton" Content="Back up now"
                                                        Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                                        Click="GoogleDriveBackupButton_OnClick"/>
                                            </StackPanel>
                                            <TextBlock x:Name="GoogleDriveBackupStatusText"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="HOW TO CONNECT GOOGLE DRIVE" Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="1. Open Google Cloud Console and select your FluxChat Drive project."
                                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            <TextBlock Text="2. Open APIs &amp; Services, then Library, find Google Drive API, and enable it."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="3. Open Google Auth Platform. If it is not configured, click Get started."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="4. In Branding, fill the app name, support email, and developer contact email, then save."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="5. In Audience, use External for a normal Google account. While testing, add your Google account as a test user."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="6. In Data Access, add the Google Drive API scope: drive.file."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="7. In Clients, create an OAuth client. Application type must be Desktop app."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="8. Copy the Client ID, paste it into the field above, then click Connect Google Drive."
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="If Google Cloud says access is blocked, enable 2-step verification on your Google account and refresh the page after a few minutes."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            <Border Background="#282a30" BorderBrush="#3f424b" BorderThickness="1"
                                                    CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                                <TextBlock Text="Important: use only the Client ID. FluxChat does not need a client secret for the Desktop OAuth flow."
                                                           Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Reduced motion" FontWeight="SemiBold"/>
                                                <TextBlock Text="Disables hover and press animations throughout FluxChat."
                                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,12,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsReducedMotionCheck" Grid.Column="1"
                                                      Style="{StaticResource SmoothCheckBox}" VerticalAlignment="Center"
                                                      Checked="SettingsReducedMotionCheck_OnChanged"
                                                      Unchecked="SettingsReducedMotionCheck_OnChanged"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SettingsCustomizationContent"
                                          Grid.Row="2"
                                          Grid.RowSpan="2"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="#313338" BorderBrush="#45474f" BorderThickness="1"
                                            CornerRadius="8" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="WALLPAPERS"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
