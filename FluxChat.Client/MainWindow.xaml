                                                </StackPanel>
                                                <CheckBox x:Name="AutoDndEnabledCheck" Grid.Column="1" Style="{StaticResource SmoothCheckBox}" VerticalAlignment="Center" Checked="AutoDndCheck_OnChanged" Unchecked="AutoDndCheck_OnChanged"/>
                                            </Grid>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                                <ComboBox x:Name="AutoDndPresetCombo" Height="34" SelectionChanged="AutoDndPresetCombo_OnSelectionChanged">
                                                    <ComboBoxItem Content="Night" Tag="Night"/>
                                                    <ComboBoxItem Content="Study" Tag="Study"/>
                                                    <ComboBoxItem Content="Work" Tag="Work"/>
                                                    <ComboBoxItem Content="Game" Tag="Game"/>
                                                    <ComboBoxItem Content="Custom" Tag="Custom"/>
