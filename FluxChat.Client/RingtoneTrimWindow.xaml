<Window x:Class="FluxChat.Client.RingtoneTrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim ringtone"
        Width="760"
        Height="520"
        MinWidth="660"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI"
        Loaded="Window_OnLoaded"
        KeyDown="Window_OnKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#f2f3f5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#b5bac1"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#80848e"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5865f2"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#5eead4"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2b2d31"/>
        <SolidColorBrush x:Key="InputBrush" Color="#383a40"/>
        <SolidColorBrush x:Key="LineBrush" Color="#45474f"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#363940"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#42454e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4a4d57"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SmoothSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Accent2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="#5865f2"
                                                  BorderThickness="0"
                                                  Opacity="0.72"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="#3a3d45"
                                                  BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource Accent2Brush}"
                                                        BorderBrush="#0f1418"
                                                        BorderThickness="2"
                                                        CornerRadius="9"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#88000000" CornerRadius="18"/>

        <Border x:Name="DialogCard"
                Width="700"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.42" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Trim ringtone"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Choose the exact 20-second part that should play when somebody calls."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#363940"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Close"
                            Click="CancelButton_OnClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <Path Data="M7,7 L17,17 M17,7 L7,17"
                                          Stroke="{StaticResource TextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border Grid.Row="2"
                        Background="#1f2127"
                        BorderBrush="#3f424b"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <Grid>
                        <Canvas x:Name="WaveformCanvas"
                                Height="150"
                                Background="#191b20"
                                ClipToBounds="True"
                                SizeChanged="WaveformCanvas_OnSizeChanged"
                                MouseLeftButtonDown="WaveformCanvas_OnMouseLeftButtonDown"/>
                        <Border x:Name="SelectionOverlay"
                                Height="150"
                                Background="#225865f2"
                                BorderBrush="#805eead4"
                                BorderThickness="1,0"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
                        <Line x:Name="PlayheadLine"
                              Y1="0"
                              Y2="150"
                              Stroke="#f2f3f5"
                              StrokeThickness="2"
                              Opacity="0.9"
                              Visibility="Collapsed"
                              IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Start" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="StartSlider"
                            Grid.Column="2"
                            Style="{StaticResource SmoothSlider}"
                            ValueChanged="StartSlider_OnValueChanged"/>
                    <TextBlock x:Name="StartText"
                               Grid.Column="4"
                               Width="58"
                               TextAlignment="Right"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Text="End" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="EndSlider"
                            Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource SmoothSlider}"
                            ValueChanged="EndSlider_OnValueChanged"/>
                    <TextBlock x:Name="EndText"
                               Grid.Row="2"
                               Grid.Column="4"
                               Width="58"
                               TextAlignment="Right"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton"
                            Content="Play selected"
                            Style="{StaticResource DialogButton}"
                            Click="PlayButton_OnClick"/>
                    <TextBlock x:Name="SelectionText"
                               Grid.Column="2"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3"
                               Text="Max 20 seconds"
                               Foreground="{StaticResource SubtleBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Style="{StaticResource DialogButton}"
                            Click="CancelButton_OnClick"/>
                    <Button Grid.Column="3"
                            Content="Use this part"
                            Style="{StaticResource PrimaryDialogButton}"
                            Click="SaveButton_OnClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
