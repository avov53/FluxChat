<Window x:Class="FluxChat.Client.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxChat" Width="1100" Height="720" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#17191E" Foreground="#F7F8FC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <CubicEase x:Key="SmoothOut" EasingMode="EaseOut"/>

        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="2,0" CornerRadius="3" Background="#5B6070"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ModernScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8BCC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,12,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Foreground" Value="#F7F8FC"/>
            <Setter Property="Background" Value="#292C34"/>
            <Setter Property="BorderBrush" Value="#424754"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#7ED7C4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#65CDB7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Foreground" Value="#F7F8FC"/>
            <Setter Property="Background" Value="#292C34"/>
            <Setter Property="BorderBrush" Value="#424754"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#65CDB7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmoothButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#F7F8FC"/>
            <Setter Property="Background" Value="#30343D"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ButtonShift" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="10" Background="#25FFFFFF" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="1.4"
                                    BorderBrush="#7ED7C4" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonShift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonShift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.975" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.975" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.18" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.18" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SmoothButton}">
            <Setter Property="Background" Value="#5869F2"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SmoothButton}">
            <Setter Property="Background" Value="#288B78"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#83D8C5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource SmoothButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#2C3038"/>
            <Setter Property="BorderBrush" Value="#3D424E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SavedAccountListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#20232A"/>
            <Setter Property="BorderBrush" Value="#424754"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="#F7F8FC"/>
        </Style>

        <Style x:Key="SavedAccountListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#30343D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#374055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#17191E"/>
        </Grid.Background>

        <Border VerticalAlignment="Top" Height="1" Background="#3B4250"/>
        <Border HorizontalAlignment="Left" Width="12" Background="#20242C"/>
        <Border HorizontalAlignment="Right" Width="12" Background="#20242C"/>

        <Grid Margin="44,30">
            <TextBlock Text="FluxChat" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock x:Name="AccountPrivateText" Text="Private conversations, one account."
                       Foreground="#747B8B" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>

            <Border x:Name="AccountCard" Width="540" MaxHeight="610" Padding="36" CornerRadius="12"
                    Background="#20232A" BorderBrush="#373B46" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AccountCardScale" ScaleX="0.985" ScaleY="0.985"/>
                        <TranslateTransform x:Name="AccountCardShift" X="0" Y="12"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <Grid x:Name="WelcomePage">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="12" Background="#2D3340"
                                    HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock Text="#" FontSize="34" FontWeight="Bold" Foreground="#7ED7C4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="WelcomeTitleText" Text="Welcome to FluxChat" FontSize="30" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="WelcomeSubtitleText" Text="Sign in to see your conversations, or create your account."
                                       Foreground="#9EA4B2" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="14" Margin="30,10,30,30"/>
                            <Button x:Name="WelcomeSignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                                    Margin="70,0,70,12" Click="WelcomeSignInButton_OnClick"/>
                            <Button x:Name="WelcomeCreateAccountButton" Content="Create account" Style="{StaticResource AccentButton}"
                                    Margin="70,0" Click="WelcomeCreateAccountButton_OnClick"/>
                            <TextBlock x:Name="WelcomePrivacyText" Text="Your contacts and status stay hidden until you sign in."
                                       Foreground="#6F7685" FontSize="11" TextAlignment="Center"
                                       Margin="20,24,20,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SignInPage" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="SignInBackButton" Style="{StaticResource BackButton}" Click="BackToWelcomeButton_OnClick"
                                    ToolTip="Back" VerticalAlignment="Top">
                                <Viewbox Width="16" Height="16">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Data="M 12 4 L 4 12 L 12 20"/>
                                </Viewbox>
                            </Button>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="SignInTitleText" Text="Sign in" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SignInSubtitleText" Text="Continue to your FluxChat account." Foreground="#9EA4B2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <TextBlock x:Name="SignInLoginLabelText" Text="Login" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LoginInput"
                                     GotKeyboardFocus="LoginInput_OnGotKeyboardFocus"
                                     PreviewMouseDown="LoginInput_OnPreviewMouseDown"
                                     TextChanged="LoginInput_OnTextChanged"
                                     LostKeyboardFocus="LoginInput_OnLostKeyboardFocus"/>
                            <Popup x:Name="SavedAccountsPopup"
                                   PlacementTarget="{Binding ElementName=LoginInput}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=LoginInput}"
                                        Margin="0,6,0,0"
                                        Background="#20232A"
                                        BorderBrush="#424754"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3">
                                    <ListBox x:Name="SavedAccountsList"
                                             Style="{StaticResource SavedAccountListBox}"
                                             ItemContainerStyle="{StaticResource SavedAccountListItem}"
                                             MaxHeight="190"
                                             MouseLeftButtonUp="SavedAccountsList_OnMouseLeftButtonUp"
                                             SelectionChanged="SavedAccountsList_OnSelectionChanged"/>
                                </Border>
                            </Popup>
                            <TextBlock x:Name="SignInPasswordLabelText" Text="Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PasswordInput" GotKeyboardFocus="PasswordInput_OnGotKeyboardFocus"/>
                            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                                    Margin="0,22,0,0" Click="SignInButton_OnClick"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="SignInServerLabelText" Text="VPS server" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SignInApiUrlInput" ToolTip="IP address and relay port, for example 91.186.217.186:42800"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="RegisterPage" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="RegisterBackButton" Style="{StaticResource BackButton}" Click="BackToWelcomeButton_OnClick"
                                    ToolTip="Back" VerticalAlignment="Top">
                                <Viewbox Width="16" Height="16">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Data="M 12 4 L 4 12 L 12 20"/>
                                </Viewbox>
                            </Button>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="RegisterTitleText" Text="Create account" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RegisterSubtitleText" Text="One account for all your FluxChat devices." Foreground="#9EA4B2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="RegisterLoginLabelText" Text="Login" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NewLoginInput"/>
                                <TextBlock x:Name="RegisterPasswordLabelText" Text="Password (10 or more characters)" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="NewPasswordInput"/>
                                <TextBlock x:Name="RegisterRepeatPasswordLabelText" Text="Repeat password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ConfirmPasswordInput"/>
                                <TextBlock x:Name="RegisterServerLabelText" Text="VPS server" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegisterApiUrlInput" ToolTip="IP address and relay port, for example 91.186.217.186:42800"/>
                                <TextBlock x:Name="RegisterInviteLabelText" Text="Invite code" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RegisterInviteInput" ToolTip="Your one-time VPS invite code"/>
                                <Button x:Name="RegisterButton" Content="Create account"
                                        Style="{StaticResource AccentButton}" Margin="0,22,0,0"
                                        Click="RegisterButton_OnClick"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="VerifyPage" Visibility="Collapsed" Opacity="0">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="10" Background="#2D3340"
                                    HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="✓" FontSize="27" Foreground="#7ED7C4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Check your email" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Text="Enter the eight-digit verification code. It expires in 15 minutes."
                                       Foreground="#9EA4B2" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="24,9,24,22"/>
                            <TextBox x:Name="VerificationCodeInput" MaxLength="8" FontSize="18"
                                     TextAlignment="Center" Width="260"/>
                            <Button x:Name="VerifyButton" Content="Verify and continue"
                                    Style="{StaticResource PrimaryButton}" Width="260" Margin="0,18,0,0"
                                    Click="VerifyEmailButton_OnClick"/>
                            <Button Content="Send another code" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Center" Margin="0,15,0,0"
                                    Click="ResendVerificationButton_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="RecoveryPage" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Button Style="{StaticResource BackButton}" Click="BackToSignInButton_OnClick"
                                    ToolTip="Back">
                                <Viewbox Width="16" Height="16">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Data="M 12 4 L 4 12 L 12 20"/>
                                </Viewbox>
                            </Button>
                            <StackPanel Margin="58,0,0,0">
                                <TextBlock x:Name="RecoveryTitle" Text="Sign in with a code" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RecoverySubtitle" Text="We will send an eight-digit code to your email."
                                           Foreground="#9EA4B2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <TextBlock Text="Login or email" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RecoveryLoginInput"/>
                            <Button x:Name="SendRecoveryCodeButton" Content="Send code"
                                    Style="{StaticResource AccentButton}" Margin="0,15,0,0"
                                    Click="SendRecoveryCodeButton_OnClick"/>
                            <TextBlock Text="Eight-digit code" Style="{StaticResource FieldLabel}" Margin="2,20,0,5"/>
                            <TextBox x:Name="RecoveryCodeInput" MaxLength="8" TextAlignment="Center" FontSize="18"/>
                            <StackPanel x:Name="ResetPasswordFields" Visibility="Collapsed">
                                <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ResetPasswordInput"/>
                                <TextBlock Text="Repeat new password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ResetPasswordConfirmInput"/>
                            </StackPanel>
                            <Button x:Name="RecoveryActionButton" Content="Sign in"
                                    Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                    Click="RecoveryActionButton_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#D920232A" CornerRadius="9">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                                         Foreground="#65CDB7" Background="#353A45"/>
                            <TextBlock x:Name="BusyText" Text="Please wait..." Foreground="#B8BCC8" TextAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatusPanel" Visibility="Collapsed" Background="#2B2F38"
                            BorderBrush="#454A56" BorderThickness="1" CornerRadius="8"
                            VerticalAlignment="Bottom" Margin="0,0,0,-22" Padding="12,9">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#C9CDD7" TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
