<Window x:Class="FluxChat.Client.IncomingCallMiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxChat incoming call"
        Width="330"
        Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="30"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.36"
                          Color="#000000" />

        <Style x:Key="CallActionButton" TargetType="Button">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.36" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DragSurface"
            Margin="10"
            Background="#23252d"
            BorderBrush="#454956"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource CardShadow}"
            MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="Incoming call..."
                       Foreground="#f5f7ff"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="92" Height="92" HorizontalAlignment="Center">
                    <Ellipse Fill="#5865f2" />
                    <Image x:Name="AvatarImage"
                           Stretch="UniformToFill"
                           Visibility="Collapsed">
                        <Image.Clip>
                            <EllipseGeometry Center="46,46" RadiusX="46" RadiusY="46" />
                        </Image.Clip>
                    </Image>
                    <MediaElement x:Name="AvatarVideo"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Stretch="UniformToFill"
                                  IsMuted="True"
                                  Volume="0"
                                  Visibility="Collapsed"
                                  MediaEnded="AvatarVideo_OnMediaEnded">
                        <MediaElement.Clip>
                            <EllipseGeometry Center="46,46" RadiusX="46" RadiusY="46" />
                        </MediaElement.Clip>
                    </MediaElement>
                    <TextBlock x:Name="AvatarInitials"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                </Grid>

                <TextBlock x:Name="CallerNameText"
                           Margin="0,18,0,0"
                           MaxWidth="250"
                           HorizontalAlignment="Center"
                           Foreground="#f7f8ff"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#aeb6c8"
                           FontSize="13"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="DeclineButton"
                        Style="{StaticResource CallActionButton}"
                        Background="#e11d2e"
                        ToolTip="Decline"
                        Click="DeclineButton_OnClick">
                    <Viewbox Width="24" Height="24">
                        <Path Fill="White"
                              Stretch="Uniform"
                              Data="M18.3,5.7L12,12L5.7,5.7L4.3,7.1L10.6,13.4L4.3,19.7L5.7,21.1L12,14.8L18.3,21.1L19.7,19.7L13.4,13.4L19.7,7.1L18.3,5.7Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="AcceptAudioButton"
                        Margin="14,0,0,0"
                        Style="{StaticResource CallActionButton}"
                        Background="#22c55e"
                        ToolTip="Accept audio"
                        Click="AcceptAudioButton_OnClick">
                    <Viewbox Width="23" Height="23">
                        <Path Fill="White"
                              Stretch="Uniform"
                              Data="M6.6,10.8C8,13.6 10.4,16 13.2,17.4L15.4,15.2C15.7,14.9 16.1,14.8 16.5,14.9C17.7,15.3 19,15.5 20.3,15.5C20.9,15.5 21.4,16 21.4,16.6V20.2C21.4,20.8 20.9,21.3 20.3,21.3C10.6,21.3 2.7,13.4 2.7,3.7C2.7,3.1 3.2,2.6 3.8,2.6H7.4C8,2.6 8.5,3.1 8.5,3.7C8.5,5 8.7,6.3 9.1,7.5C9.2,7.9 9.1,8.3 8.8,8.6L6.6,10.8Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="AcceptVideoButton"
                        Margin="14,0,0,0"
                        Style="{StaticResource CallActionButton}"
                        Background="#22c55e"
                        ToolTip="Accept with video"
                        Click="AcceptVideoButton_OnClick">
                    <Viewbox Width="25" Height="25">
                        <Path Fill="White"
                              Stretch="Uniform"
                              Data="M17,10.5V6C17,5.45 16.55,5 16,5H4C3.45,5 3,5.45 3,6V18C3,18.55 3.45,19 4,19H16C16.55,19 17,18.55 17,18V13.5L21,17.5V6.5L17,10.5Z" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
