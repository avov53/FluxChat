<Window x:Class="FluxChat.Client.IncomingCallMiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxChat incoming call"
        Width="300"
        Height="280"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.36"
                          Color="#000000" />

        <Style x:Key="CallActionButton" TargetType="Button">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DragSurface"
            Margin="10"
            Background="#23252d"
            BorderBrush="#454956"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource CardShadow}"
            MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="Входящий звонок..."
                       Foreground="#f5f7ff"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="92" Height="92" HorizontalAlignment="Center">
                    <Ellipse Fill="#5865f2" />
                    <Image x:Name="AvatarImage"
                           Stretch="UniformToFill"
                           Visibility="Collapsed">
                        <Image.Clip>
                            <EllipseGeometry Center="46,46" RadiusX="46" RadiusY="46" />
                        </Image.Clip>
                    </Image>
                    <MediaElement x:Name="AvatarVideo"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Stretch="UniformToFill"
                                  IsMuted="True"
                                  Volume="0"
                                  Visibility="Collapsed"
                                  MediaEnded="AvatarVideo_OnMediaEnded">
                        <MediaElement.Clip>
                            <EllipseGeometry Center="46,46" RadiusX="46" RadiusY="46" />
                        </MediaElement.Clip>
                    </MediaElement>
                    <TextBlock x:Name="AvatarInitials"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                </Grid>

                <TextBlock x:Name="CallerNameText"
                           Margin="0,18,0,0"
                           MaxWidth="230"
                           HorizontalAlignment="Center"
                           Foreground="#f7f8ff"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#aeb6c8"
                           FontSize="13"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="DeclineButton"
                        Style="{StaticResource CallActionButton}"
                        Background="#e11d2e"
                        Content="×"
                        Click="DeclineButton_OnClick" />
                <Button x:Name="AcceptButton"
                        Margin="18,0,0,0"
                        Style="{StaticResource CallActionButton}"
                        Background="#22c55e"
                        Content="✓"
                        Click="AcceptButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
